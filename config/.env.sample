# -----------------------------------------------------------------------------
# Mojaloop IaC - Environment Variables
# Copy this file to .env and fill in your values
# -----------------------------------------------------------------------------

# --- Native Provider Env Vars (read directly by Terraform providers) ---

# Proxmox
PROXMOX_VE_ENDPOINT="https://pve.example.com:8006"
PROXMOX_VE_API_TOKEN="user@pam!token_id=your-token-secret"
PROXMOX_VE_SSH_USERNAME="root"
PROXMOX_VE_SSH_PASSWORD="your-ssh-password"
PROXMOX_VE_INSECURE="true"

# # AWS
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"

# --- Service Credentials ---

# DNS provider token (DigitalOcean)
DIGITALOCEAN_TOKEN="your-do-token"

# OCI registry credentials (for artifact push/pull and Flux OCIRepository)
# For GHCR: username = GitHub username, password = PAT with read:packages,write:packages
#   Generate PAT: gh auth refresh -s read:packages,write:packages && gh auth token
OCI_USERNAME="your-github-username"
OCI_PASSWORD="ghp_xxxxxxxxxxxx"
