# -----------------------------------------------------------------------------
# Mojaloop IaC - Environment Variables
# Copy this file to .env and fill in your values
# -----------------------------------------------------------------------------

# --- Proxmox ---
PROXMOX_VE_ENDPOINT="https://pve.example.com:8006"
PROXMOX_VE_API_TOKEN="user@pam!token_id=your-token-secret"
PROXMOX_VE_SSH_USERNAME="root"
PROXMOX_VE_SSH_PASSWORD="your-ssh-password"
PROXMOX_VE_INSECURE="true"

# --- AWS ---
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"

# --- DigitalOcean ---
DO_REGION="nyc1"
DIGITALOCEAN_TOKEN="your-do-token"

# --- OCI Registry (Harbor) ---
OCI_URL="registry.example.com"
OCI_USERNAME="admin"
OCI_PASSWORD="your-harbor-password"

# --- DNS ---
DOMAIN_NAME="example.com"
# CLOUDFLARE_API_TOKEN="your-cloudflare-token"
