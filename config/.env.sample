# -----------------------------------------------------------------------------
# Mojaloop IaC - Environment Variables
# Copy this file to .env and fill in your values
# -----------------------------------------------------------------------------

# --- Native Provider Env Vars (read directly by Terraform providers) ---

# Proxmox
PROXMOX_VE_ENDPOINT="https://pve.example.com:8006"
PROXMOX_VE_API_TOKEN="user@pam!token_id=your-token-secret"
PROXMOX_VE_SSH_USERNAME="root"
PROXMOX_VE_SSH_PASSWORD="your-ssh-password"
PROXMOX_VE_INSECURE="true"

# # AWS
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"

# --- TF_VAR_ Prefixed (used by flux-config module for K8s secrets) ---

# DNS provider token (DigitalOcean)
TF_VAR_digitalocean_token="your-do-token"

# OCI registry credentials (for Flux OCIRepository)
TF_VAR_oci_username="admin"
TF_VAR_oci_password="your-registry-password"

# --- Misc ---
# DOMAIN_NAME="example.com"   # Only if you want to override config.yaml
