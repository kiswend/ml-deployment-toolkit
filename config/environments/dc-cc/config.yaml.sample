# ------------------------------------------------------------------
# INFRASTRUCTURE & CLUSTER CONFIGURATION (sample)
# ------------------------------------------------------------------
# Copy this file to config.yaml and edit for your environment.
# Secrets live in .env (sourced via Makefile) — never put credentials here.
# Proxmox credentials: native PROXMOX_VE_* env vars.
# Flux-config secrets: TF_VAR_* env vars (digitalocean_token, oci_repo_*, oci_proxy_*).
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# 1. INFRASTRUCTURE PROVIDER
# ------------------------------------------------------------------
infra:
  provider: "proxmox"  # proxmox | aws | digitalocean

  # --- Proxmox ---
  proxmox:
    # Maps deployment template placement groups → Proxmox physical nodes
    placement:
      placement-group-1: "pve-node-1"
      placement-group-2: "pve-node-2"
      # placement-group-3: "pve-node-3"
      # placement-group-4: "pve-node-4"
    network_bridge: "vmbr0"
    storage:
      disks: "local-lvm"
      images: "local"
      snippets: "local"

  # Talos node OS overrides (optional — any on-prem provider)
  # talos:
  #   nameservers:
  #     - "8.8.8.8"
  #     - "1.1.1.1"
  #   ntp_servers:
  #     - "time.cloudflare.com"

  # # --- AWS ---
  # aws:
  #   region: "us-east-1"
  #   vpc_cidr: "10.0.0.0/16"
  #   availability_zones:
  #     - "us-east-1a"
  #     - "us-east-1b"
  #     - "us-east-1c"

  # # --- DigitalOcean ---
  # digitalocean:
  #   region: "nyc1"
  #   vpc_cidr: "10.10.0.0/16"

# ------------------------------------------------------------------
# 2. SIZING PROFILE
# ------------------------------------------------------------------
# Resolves to config/providers/{infra.provider}/profiles/{cluster.role}/{profile}.yaml
#   cc clusters:   small | medium
#   env clusters:  tps-1 | tps-500
#   base clusters: small
profile: "small"

# ------------------------------------------------------------------
# 3. CLUSTER PARAMETERS
# ------------------------------------------------------------------
cluster:
  name: "my-cluster"
  role: "cc"                          # cc | env | base — determines which gitops paths are deployed

  # Kubernetes API endpoint (on-prem only — floating IP managed by Talos VIP)
  vip: "192.168.1.10"

  # Flux configuration
  flux:
    version: "2.7.2"

# ------------------------------------------------------------------
# 4. DNS
# ------------------------------------------------------------------
dns:
  provider: "digitalocean"            # digitalocean | cloudflare | route53 | powerdns
  domain: "cc.example.com"

  # For Cloudflare:
  # cloudflare:
  #   proxied: false

  # For AWS Route53:
  # aws:
  #   region: "us-east-1"

# ------------------------------------------------------------------
# 5. APPLICATION PARAMETERS
# ------------------------------------------------------------------
app:
  # On-prem only — Cilium LB-IPAM range (must be in same L2 as cluster nodes)
  lb_ipam:
    range: "192.168.1.20-192.168.1.25"
  alert_email: "ops@example.com"

  # env clusters only — Mojaloop API dialect for ALS, quoting-service, and ml-api-adapter.
  #   fspiop    — FSPIOP 1.x JSON message bodies (default)
  #   iso20022  — ISO 20022 message bodies (FSPIOP 2.0 envelope)
  # Switching modes mid-flight breaks in-progress transfers. Set once at deploy time.
  # api_type: "fspiop"

# ------------------------------------------------------------------
# 6. BACKUP (env clusters only)
# ------------------------------------------------------------------
# backup:
#   s3:
#     endpoint: "https://s3.int.cc.example.com"
#     bucket: "backups"
#     region: "us-east-1"             # optional — defaults to us-east-1
#   # Credentials (BACKUP_S3_ACCESS_KEY, BACKUP_S3_SECRET_KEY) live in .env

# ------------------------------------------------------------------
# 7. OBSERVABILITY (env clusters only — push to CC observability stack)
# ------------------------------------------------------------------
# observability:
#   loki_url:  "https://loki.int.cc.example.com/loki/api/v1/push"
#   mimir_url: "https://thanos.int.cc.example.com/api/v1/receive"
#   # tempo_url: "https://tempo.int.cc.example.com:4318"   # Phase 3

# ------------------------------------------------------------------
# 8. OCI CONFIGURATION
# ------------------------------------------------------------------
oci:
  # OCI-REPO: Platform team's OCI registry where the Flux gitops artifact lives
  repo:
    active: true                      # Enable Flux OCI reconciliation
    url: "oci://ghcr.io/your-org/ml-iac3"
    version: "latest"                 # OCI tag — "latest" or pin to a specific version

  # OCI-PROXY: Harbor as transparent pull-through cache for container images
  # Configured at Talos level (machine.registries.mirrors) so containerd routes pulls through Harbor.
  # Typically active: false on the CC itself (Harbor is hosted here) and true on env clusters.
  proxy:
    active: false                     # Enable container image proxy through Harbor
    url: "harbor.int.cc.example.com"  # Harbor proxy cache URL (no oci:// prefix — used in Talos mirrors)
